# Credentials for the shop_arena packages.
#
# Copy this file to `.env` (gitignored) and fill in your own values.
# Values already exported in the shell take precedence over `.env`.

# --- Anthropic ---------------------------------------------------------------
#
# Required by:
#   * shop_probe `eval` when `--capture-judge-model anthropic:<id>` is
#     selected (default: `anthropic:claude-haiku-4-5`).
#
# `shop_probe.agent.judge.run_capture_judge` constructs an
# `AsyncAnthropic` client which reads these from the environment.

# Required: pick one.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: route through a private gateway.
# ANTHROPIC_BASE_URL=

# --- OpenAI ------------------------------------------------------------------
#
# Required by:
#   * shop_gen image generation when `--image-backend openai` is selected
#     (`shop_gen.data_synth.images.OpenAIImageBackend`).
#   * shop_probe `eval` when `--capture-judge-model openai:<id>` is
#     selected (`shop_probe.agent.judge.run_capture_judge`).
#
# Any drop-in compatible vendor (e.g. an internal proxy) works by
# overriding `OPENAI_BASE_URL`.

# Required when either of the above is selected.
OPENAI_API_KEY=

# Optional: unset → api.openai.com.
# OPENAI_BASE_URL=
