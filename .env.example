# Anthropic credentials for shop_probe v1.3 agent-driven probes.
#
# `shop_probe.agent.judge.run_completion_judge` constructs an
# `AsyncAnthropic` client which reads these from the environment.
# Copy this file to `.env` (gitignored) and fill in your own values.

# Required: pick one.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: route through a private gateway.
# ANTHROPIC_BASE_URL=

# OpenAI-compatible credentials for shop_gen v0.2 image generation.
#
# `shop_gen.data_synth.images.OpenAIImageBackend` constructs an
# `AsyncOpenAI` client which reads these from the environment when
# `--image-backend openai` is selected. Any drop-in compatible vendor
# (e.g. an internal proxy) works by overriding `OPENAI_BASE_URL`.

# Required when --image-backend openai.
OPENAI_API_KEY=

# Optional: unset → api.openai.com.
# OPENAI_BASE_URL=
