# Credentials for ShopGym agent runs, read by `loadCredentials` in
# @shop-gym/core (packages/core/src/env.ts).
#
# Copy this file to `.env` (gitignored) and fill in the values you use.
# Values exported in the shell take precedence over `.env`; empty values
# count as unset. `shopgym doctor` lists which keys are present (names only).

# --- Gateway routing ---------------------------------------------------------
# When a *_BASE_URL is set, requests for that provider go through the gateway
# and PI_PROXY_API_KEY is used as the key (falling back to the provider key).
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
PI_PROXY_API_KEY=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# --- OpenAI ------------------------------------------------------------------
# Also used by `shopgym gen --image-backend openai`.
OPENAI_API_KEY=
