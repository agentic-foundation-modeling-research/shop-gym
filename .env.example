# Credentials for ShopGym agent runs.
#
# Copy this file to `.env` (gitignored) and fill in your own values.
# Values already exported in the shell take precedence over `.env`.

# --- Anthropic ---------------------------------------------------------------
# Required: pick one.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: route through a compatible API gateway.
# ANTHROPIC_BASE_URL=

# --- OpenAI ------------------------------------------------------------------
# Any drop-in compatible vendor works by
# overriding `OPENAI_BASE_URL`.

# Required when either of the above is selected.
OPENAI_API_KEY=

# Optional: unset → api.openai.com.
# OPENAI_BASE_URL=

# --- pi coding agent ---------------------------------------------------------
# API key for the gateway named by ANTHROPIC_BASE_URL / OPENAI_BASE_URL when
# running agents through the pi SDK. Leave unset to use the provider keys above.
# PI_PROXY_API_KEY=
