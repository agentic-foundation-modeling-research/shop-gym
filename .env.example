# Credentials for the shop_arena packages.
#
# Copy this file to `.env` (gitignored) and fill in your own values.
# Values already exported in the shell take precedence over `.env`.

# --- Anthropic ---------------------------------------------------------------
#
# Required by the Anthropic-backed agent runtime / judge model paths.

# Required: pick one.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional: override base URL.
# ANTHROPIC_BASE_URL=

# --- OpenAI ------------------------------------------------------------------
#
# Required by:
#   * shop_gen image generation when `--image-backend openai` is selected
#     (`shop_gen.data_synth.images.OpenAIImageBackend`).

# Required when the above is selected.
OPENAI_API_KEY=

# Optional: unset → api.openai.com.
# OPENAI_BASE_URL=
